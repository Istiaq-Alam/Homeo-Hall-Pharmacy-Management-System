# ---------------------------------------------------------------------------
# Homeo-Hall production environment reference
#
# This file is documentation only. Do NOT create a .env in the container and
# do NOT commit real values. Set these variables in the Render Dashboard
# (Service -> Environment) or in render.yaml with sync: false.
# ---------------------------------------------------------------------------

APP_NAME=Homeo-Hall
APP_ENV=production
APP_DEBUG=false

# Copy the existing local APP_KEY verbatim (php artisan key:generate would
# create a new key and invalidate encrypted session payloads). Never change it
# between deploys.
APP_KEY=base64:REPLACE_WITH_THE_EXISTING_APPLICATION_KEY

# Set to the final Render URL, including https:// and no trailing slash.
APP_URL=https://REPLACE_WITH_YOUR_SERVICE.onrender.com

APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Logs go to Render's log stream, never to a container file.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# TiDB Cloud Starter (MySQL compatibility, port 4000)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=REPLACE_WITH_TIDB_HOST
DB_PORT=4000
DB_DATABASE=REPLACE_WITH_TIDB_DATABASE
DB_USERNAME=REPLACE_WITH_TIDB_USERNAME
DB_PASSWORD=REPLACE_WITH_TIDB_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# TLS is mandatory for TiDB Cloud public endpoints. The container ships the
# system CA bundle; verification is on so a wrong hostname fails loudly.
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DB_SSL_VERIFY_SERVER_CERT=true

# ---------------------------------------------------------------------------
# Sessions, cache and queue
# ---------------------------------------------------------------------------
# Database-backed sessions survive restarts and redeploys.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database

# The app records transactions synchronously; no queue worker runs on Render
# Free. Keep sync so nothing is written to an unprocessed jobs table.
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# Uploads: Cloudflare R2 via the S3-compatible API
# ---------------------------------------------------------------------------
# FILESYSTEM_DISK stays local for temporary files (PDF/profile work), while
# permanent uploads (chamber logos, avatars) use UPLOADS_DISK.
FILESYSTEM_DISK=local
UPLOADS_DISK=s3

AWS_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=homeo-hall-files
AWS_ENDPOINT=https://REPLACE_WITH_R2_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---------------------------------------------------------------------------
# PDF rendering (Bangla text needs a shaping engine: WeasyPrint first, then
# Chromium; Dompdf is the last-resort fallback and does not shape Bengali)
# ---------------------------------------------------------------------------
PDF_DRIVER=auto
PDF_WEASYPRINT_BINARY=/usr/bin/weasyprint
PDF_CHROME_BINARY=/usr/bin/chromium
PDF_TIMEOUT=60
PDF_FALLBACK=true

# The application does not send email today. Keep mail local and silent.
MAIL_MAILER=log

# Never enable local-only diagnostics in production.
APP_MAINTENANCE_DRIVER=file
